{
  "mcpServers": {
    "jcodemunch": {
      "command": "uvx",
      "args": [
        "jcodemunch-mcp"
      ]
    },
    "printify": {
      "command": "bash",
      "args": [
        "scripts/run-printify-mcp.sh"
      ],
      "env": {
        "PRINTIFY_API_KEY": "${PRINTIFY_API_KEY:-}",
        "PRINTIFY_SHOP_ID": "${PRINTIFY_SHOP_ID:-}"
      }
    }
  }
}
